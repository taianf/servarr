#!/usr/bin/env bash
# render-secrets: decrypt secrets.enc.yaml (sops) and emit a
# helmfile-readable secrets.dec.yaml + a k8s Secret manifest for
# every *arr app. The decrypted file is gitignored.
#
# Usage:
#   bin/render-secrets                  # decrypt + emit
#   bin/render-secrets --stdout         # print to stdout only
#
# Requires: sops, age key at /etc/ssh/ssh_host_ed25519_key (same
# one that decrypts ~/dotfiles/secrets.yaml — the .sops.yaml in
# this repo points at the same recipient).
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ENCRYPTED="$REPO_ROOT/secrets.enc.yaml"
DECRYPTED="$REPO_ROOT/secrets.dec.yaml"
SECRETS_MANIFEST="$REPO_ROOT/manifests/30-secrets.yaml"

if [ ! -f "$ENCRYPTED" ]; then
  echo "ERROR: $ENCRYPTED not found" >&2
  exit 1
fi

# sops reads .sops.yaml in the same dir for the recipient rules.
# Falls back to the default recipient list if .sops.yaml is missing.
DECRYPTED_CONTENT=$(sops --decrypt "$ENCRYPTED")

if [ "${1:-}" = "--stdout" ]; then
  echo "$DECRYPTED_CONTENT"
  exit 0
fi

echo "$DECRYPTED_CONTENT" > "$DECRYPTED"
echo "Wrote $DECRYPTED"

# Build the k8s Secret manifest. Each top-level key under secrets
# (sonarr, radarr, ...) becomes a Secret named "<key>-secrets" in
# the servarr namespace. The secret contents are the inner
# api_key / password / etc. fields. We use uv to run a one-shot
# Python with PyYAML — no yq dependency.
uv run --with pyyaml --quiet -- python3 - "$DECRYPTED" > "$SECRETS_MANIFEST" <<'PY'
import sys, yaml
src = sys.argv[1]
data = yaml.safe_load(open(src))
docs = ["# Auto-generated by bin/render-secrets. Do not edit by hand.", "---"]
for app, fields in data.items():
    if app == "sops" or not isinstance(fields, dict):
        continue
    string_data = {k: str(v) for k, v in fields.items()}
    doc = {
        "apiVersion": "v1",
        "kind": "Secret",
        "metadata": {"name": f"{app}-secrets", "namespace": "servarr"},
        "type": "Opaque",
        "stringData": string_data,
    }
    docs.append(yaml.dump(doc, default_flow_style=False, sort_keys=False))
print("\n---\n".join(docs))
PY

echo "Wrote $SECRETS_MANIFEST"
